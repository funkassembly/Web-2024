<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Civilian's Dashboard</title>
    <link rel="stylesheet" href="/styles/civilianDashboard.css">
    <link rel="icon" href="/maptry/icons/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
</head>
<body>

    <div class="header-links">
        <a href="#" id="instructionsLink" class="left-link">Instructions</a>
        <a href="/logout" class="right-link">Logout</a>
    </div>

    <!-- Instructions Modal -->
    <div id="instructionsModal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <h2>Instructions</h2>
            <p>1. Use the map to view your location and nearby resources.</p>
            <p>2. In the 'Request' tab, specify your needs for essential items.</p>
            <p>3. In the 'History' tab, view your previous requests and their statuses.</p>
        </div>
    </div>

    <!-- Product Modal -->
    <div id="productModal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <h2>Available Products in General Storage</h2>
            <div class="product-list">
                <table id="productTable">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Table will be populated by JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <h1>Dashboard Civilian</h1>
    <div class="dashboard-container">
        
        <div class="map-container" id="map"></div>

        <div class="request-history-container">
            <div class="checkbox-container">
                <label class="checkbox-label">
                    <input type="checkbox" id="requestCheckbox"> Request
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" id="donateCheckbox"> Donate
                </label>
            </div>

            <div class="tabs">
                <button id="requestTabBtn" class="tab-button active" onclick="openTab('requestTab', this)">Request</button>
                <button id="historyTabBtn" class="tab-button" onclick="openTab('historyTab', this)">History</button>
            </div>
        
            <div id="requestTab" class="tab-content">
                <!-- Dynamic Form -->
                <form id="dynamicForm">
                    <!-- Content will be populated by JavaScript -->
                </form>
            </div>
        
            <div id="historyTab" class="tab-content">
                <h3>Your Transaction History</h3>
                <table id="historyTable">
                    
                    <tbody id="historyContent">
                        <!-- Request rows will be dynamically added here -->
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script>
        // Debounce function to limit how often the location update is triggered
        function debounce(func, wait) {
            let timeout;
            return function(...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }
        // Initialize the map
        const map = L.map('map').setView([38.2462420, 21.7350847], 16);
        
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        // Marker icons
        const StorageIcon = L.icon({
            iconUrl: '/maptry/icons/Storage.png', 
            iconSize: [30, 30],
            iconAnchor: [15,8],
            popupAnchor: [0, 0]
        });
        const RequestIcon = L.icon({
            iconUrl: '/maptry/icons/peoplePending.png',
            iconSize: [30, 30],
            iconAnchor: [15, 30],
            popupAnchor: [0, -30]
        });
        const DonateIcon = L.icon({
            iconUrl: '/maptry/icons/donate.png',
            iconSize: [20, 20],
            iconAnchor: [15, 30],
            popupAnchor: [0, -30]
        });
        var markerStorage = L.marker([38.24600, 21.73500], {icon: StorageIcon}).addTo(map);
        // Civilian marker
        var markerCivilian = L.marker([38.24600, 21.73500], {
            icon: RequestIcon,
            draggable: true
        }).addTo(map);
        markerCivilian.bindPopup('Σύρε με στην τοποθεσία σου!').openPopup();
        
        // Debounced update function for marker movement
        const debouncedUpdateAddress = debounce(async function() {
            const latLng = markerCivilian.getLatLng();
            try {
                const response = await fetch('/updateCivilianLocation', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        lat: latLng.lat,
                        lng: latLng.lng
                    })
                });
                
                const data = await response.json();
                if (data.success) {
                    console.log('Location updated successfully');
                } else {
                    console.error('Failed to update location');
                }
            } catch (error) {
                console.error('Error:', error);
            }
        }, 300); // 300ms debounce delay

        // Attach the debounced update function to the marker's 'moveend' event
        markerCivilian.on('moveend', debouncedUpdateAddress);

        // Function to toggle the marker icon based on checkbox selection
        function toggleMarkerIcon() {
            if (document.getElementById('requestCheckbox').checked) {
                markerCivilian.setIcon(RequestIcon);
                document.getElementById('donateCheckbox').checked = false; // Uncheck the donate option
                generateRequestForm();
            } else if (document.getElementById('donateCheckbox').checked) {
                markerCivilian.setIcon(DonateIcon);
                document.getElementById('requestCheckbox').checked = false; // Uncheck the request option
                generateDonateForm();
            } else {
                // Default to RequestIcon if neither is selected (could also remove marker if desired)
                markerCivilian.setIcon(RequestIcon);
                generateRequestForm();
            }
        }

        // Event listeners for the checkboxes
        document.getElementById('requestCheckbox').addEventListener('change', toggleMarkerIcon);
        document.getElementById('donateCheckbox').addEventListener('change', toggleMarkerIcon);

        // Populate form for Request
        async function generateRequestForm() {
            const form = document.getElementById('dynamicForm');
            form.innerHTML = `
                <h3>Request Essential Items</h3>
                <div class="date-time-container">
                    <label for="date">Date:</label>
                    <input type="text" id="date" name="date" value="${new Date().toLocaleString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' })}" readonly>
                    
                    <label for="time">Time:</label>
                    <input type="text" id="time" name="time" value="${new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}" readonly>
                </div><br><br>
                <div id="addressDisplay" class="address-display">
                    <div class="address-row">
                        <label for="longitude">Longitude:</label>
                        <input type="text" id="longitude" readonly>
                        
                        <label for="latitude">Latitude:</label>
                        <input type="text" id="latitude" readonly>
                    </div>
                    <div class="address-row">
                        <label for="street">Street:</label>
                        <input type="text" id="street" readonly>
                        
                        <label for="number">Number:</label>
                        <input type="text" id="number" readonly>
                    </div>
                    <div class="address-row">
                        <label for="city">City:</label>
                        <input type="text" id="city" readonly>
                    </div>
                    <div class="address-row">
                        <label for="country">Country:</label>
                        <input type="text" id="country" readonly>
                    </div>
                    <div class="address-row">
                        <label for="postalcode">Postal Code:</label>
                        <input type="text" id="postalcode" readonly>
                    </div>
                </div>
                <div class="product-delivery-container">
                    <h4>Product Select</h4>
                    <div id="productRowsContainer">
                        <div class="product-select-container">
                            <label for="category">Category:</label>
                            <select id="category" class="category-select" onchange="updateProducts(this)">
                                <option value="">All Categories</option>
                                <!-- Categories will be populated dynamically -->
                            </select>
                            <label for="products">Products:</label>
                            <select id="products" class="products-select" disabled>
                                <!-- Products will be populated dynamically based on category selection -->
                            </select>
                            <label for="people">People:</label>
                            <select class="people-select">
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                                <option value="6">6</option>
                                <option value="7">7</option>
                                <option value="8">8</option>
                                <option value="9">9</option>
                                <option value="10">10</option>
                                <option value="11">11</option>
                                <option value="12">12</option>
                            </select>
                        </div>
                    </div>
                    <button type="button" id="addProductButton" class="add-product-button" onclick="addProductRow()">Add Product</button>
                </div>
                <div class="delivery-date-container">
                    <label for="delivery-date">Delivery Date:</label>
                    <input type="date" id="delivery-date" name="delivery-date">
                    
                    <label for="delivery-time-hour">Time Slot:</label>
                    <select id="delivery-time-hour" name="delivery-time-hour" class="small-select">
                        ${Array.from({ length: 24 }, (_, i) => `<option value="${i.toString().padStart(2, '0')}">${i.toString().padStart(2, '0')}</option>`).join('')}
                    </select>
                    <select id="delivery-time-minute" name="delivery-time-minute" class="small-select">
                        <option value="00">00</option>
                        <option value="15">15</option>
                        <option value="30">30</option>
                        <option value="45">45</option>
                    </select>
                </div><br><br>
                <button type="submit" id="requestButton" class="request-button">Request</button>
            `;
            updateAddressPlaceholder(); // Update the address field with the current coordinates
            const categorySelectElement = form.querySelector('.category-select');
            if (categorySelectElement) {
                await populateCategories(categorySelectElement); // Ensure the element is passed correctly
            } else {
                console.error('Category select element not found.');
            }
        }

        async function addProductRow() {
            const container = document.getElementById('productRowsContainer');
            
            // Create a new row for product selection
            const newRow = document.createElement('div');
            newRow.classList.add('product-select-container');
            
            newRow.innerHTML = `
                <label for="category">Category:</label>
                <select class="category-select" onchange="updateProducts(this)">
                    <option value="">All Categories</option>
                    <!-- Categories will be populated dynamically -->
                </select>
                <label for="products">Products:</label>
                <select class="products-select> disabled>
                    <!-- Products will be populated dynamically based on category selection -->
                </select>
                <label for="people">People:</label>
                <select class="people-select">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="7">7</option>
                    <option value="8">8</option>
                    <option value="9">9</option>
                    <option value="10">10</option>
                    <option value="11">11</option>
                    <option value="12">12</option>
                </select>
            `;
            
            // Append the new row to the container
            container.appendChild(newRow);
            // Pass the correct element to populateCategories
            const categorySelectElement = newRow.querySelector('.category-select');
    
            if (categorySelectElement) {
                await populateCategories(categorySelectElement); // Ensure the element is passed correctly
            } else {
                console.error('Newly added category select element not found.');
            }
    
        }


        async function populateCategories(selectElement) {
            try {
                console.log('Populating categories for:', selectElement);
                if (!selectElement) {
                    console.error('Select element is not defined.');
                    return;
                }

                const response = await fetch('/getCategories');
                const categories = await response.json();

                selectElement.innerHTML = '<option value="">All Categories</option>'; // Reset the select options
                categories.forEach(category => {
                    const option = document.createElement('option');
                    option.value = category; // Category number
                    option.textContent = category; // Display the category number directly
                    selectElement.appendChild(option);
                });
            } catch (error) {
                console.error('Failed to fetch categories:', error);
            }
        }


        async function populateProducts(categoryId = '', productSelectElement) {
            try {
                const url = `/getProducts?category=${categoryId}`;
                const response = await fetch(url);
                const products = await response.json();

                productSelectElement.innerHTML = ''; // Clear existing products

                if (products.length > 0) {
                    products.forEach(product => {
                        const option = document.createElement('option');
                        option.value = product._id; // Assuming _id is the unique identifier for the product
                        option.textContent = product.name; // Product name
                        productSelectElement.appendChild(option);
                    });
                    productSelectElement.disabled = false; // Enable the products dropdown
                } else {
                    productSelectElement.disabled = true; // Disable the products dropdown if no products are found
                    const option = document.createElement('option');
                    option.value = '';
                    option.textContent = 'No products available';
                    productSelectElement.appendChild(option);
                }
            } catch (error) {
                console.error('Failed to fetch products:', error);
                productSelectElement.innerHTML = '<option value="">Failed to load products</option>';
                productSelectElement.disabled = true;
            }
        }

        async function updateProducts(categorySelectElement) {
            const selectedCategory = categorySelectElement.value;
            
            const productSelectElement = categorySelectElement.closest('.product-select-container').querySelector('.products-select');
            
            if (!productSelectElement) {
                console.error('Product select element not found.');
                return;
            }

            productSelectElement.disabled = true; // Disable the dropdown while fetching
            productSelectElement.innerHTML = '<option value="">Loading...</option>'; // Temporary loading message

            if (selectedCategory) {
                await populateProducts(selectedCategory, productSelectElement); // Fetch and populate products when a category is selected
            } else {
                productSelectElement.innerHTML = '<option value="">Select a category first</option>';
                productSelectElement.disabled = true;
            }
        }

        // Populate form for Donate
        function generateDonateForm() {
            const form = document.getElementById('dynamicForm');
            form.innerHTML = `
                <h3>Donate Essential Items</h3>
                <div class="date-time-container">
                    <label for="date">Date:</label>
                    <input type="text" id="date" name="date" value="${new Date().toLocaleString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' })}" readonly>
                    
                    <label for="time">Time:</label>
                    <input type="text" id="time" name="time" value="${new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}" readonly>
                </div><br><br>
                <div id="addressDisplay" class="address-display">
                    <div class="address-row">
                        <label for="longitude">Longitude:</label>
                        <input type="text" id="longitude" readonly>
                        
                        <label for="latitude">Latitude:</label>
                        <input type="text" id="latitude" readonly>
                    </div>
                    <div class="address-row">
                        <label for="street">Street:</label>
                        <input type="text" id="street" readonly>
                        
                        <label for="number">Number:</label>
                        <input type="text" id="number" readonly>
                    </div>
                    <div class="address-row">
                        <label for="city">City:</label>
                        <input type="text" id="city" readonly>
                    </div>
                    <div class="address-row">
                        <label for="country">Country:</label>
                        <input type="text" id="country" readonly>
                    </div>
                    <div class="address-row">
                        <label for="postalcode">Postal Code:</label>
                        <input type="text" id="postalcode" readonly>
                    </div>
                </div><br><br>

                <form method="post" action="" id="item_form">
                    <label for="itname">Item Name:</label>
                    <input type="text" name="itname" id="itname" required><br><br>
                    <label for="itcats">Item Category:</label>
                    <select name="itcats" id="itcats" required>
                        <option value="">Select Category</option>
                        <!-- Populate with categories from database -->
                    </select><br><br>
                    <h3>Product Details</h3>
                    <table id="itemdetails">
                        <tr>
                            <td>Item detail name (e.g. "volume")</td>
                            <td><input name="itdname1" id="itdname1"></td>
                            <td>Item detail value (e.g. "500ml")</td>
                            <td><input name="itdvalue1" id="itdvalue1"></td>
                        </tr>
                    </table>
                    <input type="button" value="Add more details" onclick="addDetail()"><br><br>
                    <input type="button" value="Submit" onclick="send()">
                </form>
            `;
            updateAddressPlaceholder(); // Update the address field with the current coordinates
            
        }

        // Make this function async
        async function updateAddressPlaceholder() {
            markerCivilian.on('moveend', async function() {
                const latLng = markerCivilian.getLatLng();
                try {
                    const response = await fetch('/updateCivilianLocation', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            lat: latLng.lat,
                            lng: latLng.lng
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        console.log('Location updated successfully');
                    } else {
                        console.error('Failed to update location');
                    }
                } catch (error) {
                    console.error('Error:', error);
                }
                document.getElementById('longitude').value = latLng.lng.toFixed(6);
                document.getElementById('latitude').value = latLng.lat.toFixed(6);

                // Fetch address details using OpenStreetMap's Nominatim API
                try {
                    const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${latLng.lat}&lon=${latLng.lng}`;
                    const response = await fetch(url);
                    const data = await response.json();

                    // Update the address fields with data from the API
                    document.getElementById('street').value = data.address.road || '';
                    document.getElementById('number').value = data.address.house_number || '';
                    document.getElementById('city').value = data.address.city || data.address.town || data.address.village || '';
                    document.getElementById('country').value = data.address.country || '';
                    document.getElementById('postalcode').value = data.address.postcode || '';
                } catch (error) {
                    console.error('Error fetching address details:', error);
                }
            });
        }

        // Add more details for the donate form
        function addDetail() {
            const table = document.getElementById('itemdetails');
            const rowCount = table.rows.length + 1;
            const row = table.insertRow(-1);
            row.innerHTML = `
                <td>Item detail name (e.g. "volume")</td>
                <td><input name="itdname${rowCount}" id="itdname${rowCount}"></td>
                <td>Item detail value (e.g. "500ml")</td>
                <td><input name="itdvalue${rowCount}" id="itdvalue${rowCount}"></td>
            `;
        }

        // Handle form submission for the donate form
        function send() {
            const form = document.getElementById('item_form');
            // Perform form submission logic here
            console.log('Form submitted');
        }

        // Function to open the product modal and populate it with data
        function openProductModal(products) {
            const productTableBody = document.querySelector("#productTable tbody");
            productTableBody.innerHTML = ""; // Clear previous content

            products.forEach(product => {
                const row = document.createElement("tr");
                row.innerHTML = `
                    <td>${product.name}</td>
                    <td>${product.category}</td>
                    <td>${product.details.map(detail => `${detail.detail_name}: ${detail.detail_value}`).join(', ')}</td>
                `;
                productTableBody.appendChild(row);
            });

            document.getElementById('productModal').style.display = 'block';
        }

        document.getElementById('dynamicForm').addEventListener('submit', function(event) {
            event.preventDefault(); // Prevent the default form submission

            const requestDetails = {
                date: document.getElementById('date')?.value || '',
                time: document.getElementById('time')?.value || '',
                address: {
                    longitude: document.getElementById('longitude')?.value || '',
                    latitude: document.getElementById('latitude')?.value || '',
                    street: document.getElementById('street')?.value || '',
                    number: document.getElementById('number')?.value || '',
                    city: document.getElementById('city')?.value || '',
                    country: document.getElementById('country')?.value || '',
                    postalcode: document.getElementById('postalcode')?.value || '',
                },
                products: [],
                deliveryDate: document.getElementById('delivery-date')?.value || '',
                deliveryTimeSlot: {
                    hours: document.getElementById('delivery-time-hour')?.value || '',
                    minutes: document.getElementById('delivery-time-minute')?.value || ''
                }
            };

            // Collect product information
            const productElements = document.querySelectorAll('.product-select-container');
            productElements.forEach(element => {
                const category = element.querySelector('#category')?.value || '';
                const product = element.querySelector('#products')?.value || '';
                const people = element.querySelector('#people')?.value || 0;
                requestDetails.products.push({ category, product, people });
            });

            // Send request details to the server
            fetch('/saveCivilianRequest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(requestDetails)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    console.log('Request saved successfully');
                    // Optionally clear the form or give feedback to the user
                } else {
                    console.error('Failed to save request');
                }
            })
            .catch(error => {
                console.error('Error:', error);
            });
        });



        // Event listener for the storage marker
        markerStorage.on('click', async function() {
            try {
                const response = await fetch('/getProducts');
                if (!response.ok) {
                    throw new Error('Failed to fetch products');
                }
                const products = await response.json();
                openProductModal(products);
            } catch (error) {
                console.error('Error fetching or displaying products:', error);
            }
        });

        // Fetch and display request history
        async function fetchRequestHistory() {
            const historyTab = document.getElementById('historyContent');
            historyTab.innerHTML = '';

            try {
                const response = await fetch('/getRequestHistory');
                const requests = await response.json();

                if (requests.length === 0) {
                    historyTab.innerHTML = '<p>No requests found.</p>';
                    return;
                }

                const table = document.createElement('table');
                table.classList.add('request-history-table');
                
                // Create the table header
                const headerRow = document.createElement('tr');
                headerRow.innerHTML = `
                    <th>#</th>
                    <th>No</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Products</th>
                    <th>State</th>
                `;
                table.appendChild(headerRow);

                // Populate the table rows with request data
                requests.forEach((request, index) => {
                    const products = request.products.map(p => `${p.name} (x${p.people})`).join(', ');

                    const row = document.createElement('tr');
                    row.classList.add('request-row');
                    row.setAttribute('data-request-id', request._id); // Add this line
                    row.innerHTML = `
                        <td><input type="checkbox"></td>
                        <td>${index + 1}</td>
                        <td>Request</td>
                        <td>${request.date}</td>
                        <td>${products}</td>
                        <td>To be developed</td>
                    `;
                    table.appendChild(row);

                    // Create a hidden row for the expandable content
                    const detailRow = document.createElement('tr');
                    detailRow.classList.add('detail-row');
                    detailRow.style.display = 'none'; // Initially hidden
                    detailRow.innerHTML = `
                        <td colspan="6">
                            <strong>Details:</strong>
                            <p>Date: ${request.date}</p>
                            <p>Time: ${request.time}</p>
                            <p>Address: ${request.address.street} ${request.address.number}, ${request.address.city}, ${request.address.country} - ${request.address.postalcode}</p>
                            <p>Delivery Date: ${request.deliveryDate}</p>
                            <p>Delivery Time Slot: ${request.deliveryTimeSlot.hours}:${request.deliveryTimeSlot.minutes}</p>
                        </td>
                    `;
                    table.appendChild(detailRow);

                    // Add a click event listener to the main row to toggle the detail row
                    row.addEventListener('click', () => {
                        detailRow.style.display = detailRow.style.display === 'none' ? 'table-row' : 'none';
                    });
                });

                historyTab.appendChild(table);

            } catch (error) {
                console.error('Failed to fetch request history:', error);
                historyTab.innerHTML = '<p>Failed to load request history.</p>';
            }
        }


        // Load request history when the History tab is selected
        document.getElementById('historyTabBtn').addEventListener('click', fetchRequestHistory);

        function handleCheckboxChange(checkbox) {
            const row = checkbox.closest('tr');
            if (checkbox.checked) {
                addDeleteButton(row);
            } else {
                removeDeleteButton(row);
            }
        }

        function addDeleteButton(row) {
            let deleteButton = row.querySelector('.delete-button');
            if (!deleteButton) {
                deleteButton = document.createElement('button');
                deleteButton.classList.add('delete-button');
                deleteButton.textContent = '❌';
                deleteButton.style.color = 'red';
                deleteButton.style.marginLeft = '10px';

                deleteButton.addEventListener('click', function() {
                    confirmDelete(row);
                });

                const cell = document.createElement('td');
                cell.appendChild(deleteButton);
                row.appendChild(cell);
            }
        }

        function removeDeleteButton(row) {
            const deleteButton = row.querySelector('.delete-button');
            if (deleteButton) {
                deleteButton.parentElement.remove();
            }
        }

        async function confirmDelete(row) {
            const confirmed = confirm("Are you sure you want to delete this request?");
            if (confirmed) {
                const requestId = row.getAttribute('data-request-id');
                try {
                    const response = await fetch(`/deleteRequest/${requestId}`, {
                        method: 'DELETE',
                    });

                    const result = await response.json();

                    if (result.success) {
                        row.remove();
                        alert('Request deleted successfully.');
                    } else {
                        alert('Failed to delete request.');
                    }
                } catch (error) {
                    console.error('Error deleting request:', error);
                    alert('An error occurred while deleting the request.');
                }
            }
        }

        function openTab(tabName, element) {
            var i, tabcontent, tabbuttons;

            tabcontent = document.getElementsByClassName("tab-content");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
                tabcontent[i].classList.remove('active');
            }

            tabbuttons = document.querySelectorAll(".tab-button");
            for (i = 0; i < tabbuttons.length; i++) {
                tabbuttons[i].classList.remove("active");
            }

            document.getElementById(tabName).style.display = "block";
            document.getElementById(tabName).classList.add('active');

            element.classList.add("active");
        }

        document.addEventListener("DOMContentLoaded", function() {
            var activeTabButton = document.getElementById('requestTabBtn');
            if (activeTabButton) {
                openTab('requestTab', activeTabButton);
            } else {
                console.error('No tab buttons found');
            }
            const requestCheckbox = document.getElementById('requestCheckbox');
            const donateCheckbox = document.getElementById('donateCheckbox');

            // Check the Request checkbox by default
            requestCheckbox.checked = true;
            donateCheckbox.checked = false;

            // Display the Request form by default
            toggleMarkerIcon();
        });

        document.addEventListener("DOMContentLoaded", async function() {
            await generateRequestForm(); // Initialize the form when the document is loaded
        });

        // Modal handling
        document.addEventListener("DOMContentLoaded", function(){
            const modals = document.querySelectorAll('.modal');
            const closeButtons = document.querySelectorAll('.close-modal');

            document.getElementById('historyContent').addEventListener('change', function(event) {
                if (event.target.type === 'checkbox') {
                    handleCheckboxChange(event.target);
                }
            });

            document.getElementById('instructionsLink').addEventListener('click', function(event) {
                event.preventDefault();
                document.getElementById('instructionsModal').style.display = "block";
            });

            closeButtons.forEach(closeBtn => {
                closeBtn.addEventListener('click', function() {
                    closeBtn.closest('.modal').style.display = 'none';
                });
            });

            window.addEventListener('click', function(event) {
                modals.forEach(modal => {
                    if (event.target == modal) {
                        modal.style.display = "none";
                    }
                });
            });

            // Handle messages from the iframe (map) to open the product modal
            window.addEventListener('message', async function(event) {
                if (event.data.type === 'showProductModal') {
                    const response = await fetch('/getProducts');
                    const products = await response.json();
                    openProductModal(products);
                }
            });
        });
    </script>

</body>
</html>
