<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="icon" href="/maptry/icons/favicon.ico" type="image/x-icon">
    <style>
        body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #ff9900, #ffffff);
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
}

.shape {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    position: absolute;
}

.shape:nth-child(1) {
    width: 200px;
    height: 200px;
    top: -50px;
    right: -50px;
}

.shape:nth-child(2) {
    width: 300px;
    height: 300px;
    bottom: -100px;
    left: -100px;
}

form {
    background: rgba(255, 255, 255, 0.7);
    padding: 40px;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(10px);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 320px;
}

form h3 {
    margin-bottom: 20px;
    color: #333;
}

form label {
    width: 100%;
    margin-top: 10px;
    font-weight: bold;
    color: #333;
}

form input[type="text"],
form input[type="password"] {
    width: 100%;
    padding: 10px;
    margin-top: 5px;
    margin-bottom: 20px;
    border: 2px solid #ff9900;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.8);
    color: #333;
    transition: box-shadow 0.3s, background-color 0.3s;
}

form input[type="text"]:focus,
form input[type="password"]:focus {
    box-shadow: 0 0 10px 2px #ff9900;
    background-color: #fff;
}

form button {
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    background-color: #ff9900;
    color: #fff;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.3s;
    width: 100%;
}

form button:hover {
    background-color: #e68a00;
}

p {
    text-align: center;
    font-size: 1em;
    margin-bottom: 20px;
}

.signup-section {
    margin-top: 20px;
    text-align: center;
}

.signup-section p {
    font-size: 0.9em;
    color: #333;
}

.signup-section a {
    color: #ff9900;
    text-decoration: none;
    font-weight: bold;
    transition: color 0.3s;
}

.signup-section a:hover {
    color: #e68a00;
}

    </style>
</head>
<body>
    
<% if (typeof error !== 'undefined') { %>
    <p style="color: red;"><%= error %></p>
<% } %>

<div class="background">
    <div class="shape"></div>
    <div class="shape"></div>
</div>

<form action="/login" method="POST">

    <h3>Login Here</h3>

    <label for="usernameoremail">Username or Email</label>
    <input type="text" name="login" placeholder="Username or Email" id="usernameoremail" required />

    <label for="password">Password</label>
    <input type="password" name="password" placeholder="Password" id="password" required />

    <button type="submit">Login</button>

    <div class="signup-section">
        <p>Don't you have an account? <a href="/signup">Sign up</a></p>
    </div>
</form>

</body>
</html>