<body>
<div class="sidebar">
    <ul>
        <li><a href="#" data-section="datatable-category" class="menu-item active"><i class="fas fa-list"></i></a></li>
        <li><a href="#" data-section="user-form-section" class="menu-item"><i class="fas fa-user-plus"></i></a></li>
        <li><a href="#" data-section="dashboard-section" class="menu-item"><i class="fas fa-chart-bar"></i></a></li>
        <li><a href="#" data-section="map-section" class="menu-item"><i class="fas fa-map"></i></a></li>
        <li><a href="#" data-section="announcement-section" class="menu-item"><i class="fas fa-bullhorn"></i></a></li>
    </ul>
    <ul class="bottom-menu">
        <!-- <li><a href="/logout" class="menu-item"><i class="fas fa-sign-out-alt"></i></a></li> -->
        <li><button id="logoutBtn"><i class="fas fa-sign-out-alt"></i></button></li>

    </ul>
</div>

<div class="main-content">
    <!-- Categories Section -->
    <div id="datatable-category">
        <h2>Categories</h2>
        <button id="exportBtn">Export Data</button>
        <input type="file" id="importFile" />
        <button id="importBtn">Import Data</button>

        <table id="itemsTable" class="display">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Details</th>
                    <th>Stock</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data will be populated here by DataTable -->
            </tbody>
        </table>
    </div>

    <!-- Create Rescuer Section -->
    <div id="user-form-section" style="display:none;">
        <h2>Create New Rescuer</h2>
        <form id="createRescuerForm" method="POST">
            <div class="form-group">
                <label for="username">Username:</label>
                <input type="text" id="username" name="username" required>
            </div>
            <div class="form-group">
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" required>
            </div>
            <div class="form-group">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required>
            </div>
            <input type="hidden" id="role" name="role" value="rescuer">
            <button type="submit">Create Rescuer</button>
        </form>
    </div>

    <!-- New Dashboard Section -->
    <div id="dashboard-section" style="display:none;">
        <div class="dashboard-boxes">
            <!-- Box 1: Total Rescuers -->
            <div class="box" id="total-rescuers-box">
                <h3>Total Rescuers</h3>
                <p id="total-rescuers">Loading...</p>
            </div>

            <!-- Box 2: Total Civilians -->
            <div class="box" id="total-civilians-box">
                <h3>Total Civilians</h3>
                <p id="total-civilians">Loading...</p>
            </div>
        </div>

        <!-- Date selectors for filtering chart data -->
        <div class="date-filter">
            <label for="startDate">Start Date:</label>
            <input type="date" id="startDate">

            <label for="endDate">End Date:</label>
            <input type="date" id="endDate">

            <button id="updateChart">Update Chart</button>
        </div>

        <!-- Bottom Box: Chart -->
        <div class="box chart-box">
            <canvas id="task-chart" width="100" height="100"></canvas>
        </div>

        <!-- Bottom Box: Chart
        <div class="box chart-box">
            <canvas id="task-chart" width="400" height="200"></canvas>
        </div> -->
    </div>

    <div id="map-section" style="display: none;">
        
    </div>

    <div id="announcement-section" style="display: none;">
        <h2>Announcement Form</h2>
        <form id="createAnnouncement" method="POST">
            <!-- Date input -->
            <label for="date">Date:</label>
            <input type="date" id="date" name="date" required>
    
            <!-- Announcement input -->
            <label for="announcement">Announcement:</label>
            <textarea id="announcement" name="announcement" rows="4" required></textarea>
    
            <!-- Items input -->
            <label for="items">Items:</label>
            <input type="text" id="items" name="items" required>
    
            <!-- Submit button -->
            <button type="submit">Submit</button>
        </form>
    </div>
</div>
