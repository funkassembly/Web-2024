<body>
<div class="sidebar">
    <ul>
        <li><a href="#" data-section="dashboard-section" class="menu-item active"><i class="fas fa-chart-bar"></i></a></li>
        <li><a href="#" data-section="datatable-category" class="menu-item "><i class="fas fa-list"></i></a></li>
        <li><a href="#" data-section="user-form-section" class="menu-item"><i class="fas fa-user-plus"></i></a></li>
        <li><a href="#" data-section="map-section" class="menu-item"><i class="fas fa-map"></i></a></li>
        <li><a href="#" data-section="dropdown-section" class="menu-item"><i class="fas fa-filter"></i></a></li>
        <li><a href="#" data-section="announcement-section" class="menu-item"><i class="fas fa-bullhorn"></i></a></li>
    </ul>
    <ul class="bottom-menu">
        <!-- <li><a href="/logout" class="menu-item"><i class="fas fa-sign-out-alt"></i></a></li> -->
        <li><button id="logoutBtn"><i class="fas fa-sign-out-alt"></i></button></li>

    </ul>
</div>

<div class="main-content">
    <!-- Categories Section -->
    <div id="datatable-category" style="width: 100%; padding: 20px;">
        <h2>Categories</h2>
        <input type="file" id="importFile" />
        <button id="importBtn">Import Data</button>        
        <button id="exportBtn">Database Usidas</button>
<!-- Modal for Editing Item -->
<div id="editItemModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="editItemModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="editItemForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editItemModalLabel">Edit Item</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="itemId" name="itemId" />
                    <div class="form-group">
                        <label for="itemName">Name</label>
                        <input type="text" class="form-control" id="itemName" name="name" required />
                    </div>
                    <div class="form-group">
                        <label for="itemDetails">Details (format: detail_name: detail_value, ...)</label>
                        <textarea class="form-control" id="itemDetails" name="details" required></textarea>
                    </div>
                    <div class="form-group">
                        <label for="itemStock">Stock</label>
                        <input type="number" class="form-control" id="itemStock" name="stock" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

  

        <table id="itemsTable" class="display">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Details</th>
                    <th>Stock</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data will be populated here by DataTable -->
            </tbody>
        </table>
    </div>

    <!-- Create Rescuer Section -->
    <div id="user-form-section" style="display:none;">
        <h2>Create New Rescuer</h2>
        <form id="createRescuerForm" method="POST">
            <div class="form-group">
                <label for="username">Username:</label>
                <input type="text" id="username" name="username" required>
            </div>
            <div class="form-group">
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" required>
            </div>
            <div class="form-group">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required>
            </div>
            <input type="hidden" id="role" name="role" value="rescuer">
            <button type="submit">Create Rescuer</button>
        </form>
    </div>

    <!-- New Dashboard Section -->
    <div id="dashboard-section" style="display:none;">
        <div class="dashboard-boxes">
            <!-- Box 1: Total Rescuers -->
            <div class="box" id="total-rescuers-box">
                <h3>Total Rescuers</h3>
                <p id="total-rescuers">Loading...</p>
            </div>

            <!-- Box 2: Total Civilians -->
            <div class="box" id="total-civilians-box">
                <h3>Total Civilians</h3>
                <p id="total-civilians">Loading...</p>
            </div>
        </div>

        <!-- Date selectors for filtering chart data -->
        <div class="date-filter">
            <label for="startDate">Start Date:</label>
            <input type="date" id="startDate">

            <label for="endDate">End Date:</label>
            <input type="date" id="endDate">

            <button id="updateChart">Update Chart</button>
        </div>

        <!-- Dashboard boxes for Chart and Alerts -->
        <div class="dashboard-boxes">
            <!-- Box: Chart -->
            <div class="box chart-box">
                <h3>Task Chart</h3>
                <canvas id="task-chart" width="400" height="200"></canvas>
            </div>

            <!-- Box: Alerts
            <div class="box alert-box">
                <h3>Low Stock Alerts</h3>
                <div id="stock-alerts">Loading...</div>
            </div> -->
        </div>
    </div>

    <div id="map-section" style="display: none;">
        <div id="map"></div>
    </div>

       
<!-- Dropdown Section for Categories -->
<div id="dropdown-section" style="display:none;">

    <button type="button" class="button-add-category" data-toggle="modal" data-target="#addCategoryModal">Add Category & Item</button>

    <h2>Select a Category</h2>
    <div class="form-group">
        <label for="categoryDropdown">Category:</label>
        <select id="categoryDropdown" class="form-select">
            <option value="">Select a category</option>
            <!-- Categories will be dynamically populated here -->
        </select>
    </div>
    

    <h3>Items in Selected Category</h3>
    <table id="categoryItemsTable" class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Details</th>
                <th>Stock</th>
                <th>In Cargo</th>
            </tr>
        </thead>
        <tbody>
            <!-- Items will be dynamically populated here -->
        </tbody>
    </table>
</div>

<!-- Modal for Adding Category and Item -->
<div id="addCategoryModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="addCategoryForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="addCategoryModalLabel">Add Category and Item</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="newCategoryName">Category Name</label>
                        <input type="text" class="form-control" id="newCategoryName" name="category_name" required />
                    </div>
                    <div class="form-group">
                        <label for="newItemName">Item Name</label>
                        <input type="text" class="form-control" id="newItemName" name="item_name" required />
                    </div>
                    <div class="form-group">
                        <label for="newItemDetails">Details (format: detail_name: detail_value, ...)</label>
                        <textarea class="form-control" id="newItemDetails" name="item_details" required></textarea>
                    </div>
                    <div class="form-group">
                        <label for="newItemStock">Stock</label>
                        <input type="number" class="form-control" id="newItemStock" name="item_stock" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Add</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

    <div id="announcement-section" style="display: none;">
        <h2>Announcement Form</h2>
        <form id="createAnnouncement" method="POST">
            <!-- Date input -->
            <label for="date">Date:</label>
            <input type="date" id="date" name="date" required>
    
            <!-- Announcement input -->
            <label for="announcement">Announcement:</label>
            <textarea id="announcement" name="announcement" rows="4" required></textarea>
    
            <!-- Items input -->
            <label for="items">Items:</label>
            <input type="text" id="items" name="items" required>
    
            <!-- Submit button -->
            <button type="submit">Submit</button>
        </form>
    </div>
</div>
