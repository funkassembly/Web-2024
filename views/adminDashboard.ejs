    $.ajax({
            url: '/api/stats/rescuer-civilian-count',
            method: 'GET',
            success: function(data) {
                $('#total-rescuers').text(data.totalRescuers);
                $('#total-civilians').text(data.totalCivilians);
            },
            error: function(err) {
                console.error('Error fetching counts:', err);
            }
        });


        // Form submission logic for creating a new rescuer  --WORKING
        $('#createRescuerForm').on('submit', function(e) {
            e.preventDefault();

            const formData = {
                username: $('#username').val(),
                email: $('#email').val(),
                password: $('#password').val(),
                role: $('#role').val() // Hidden field for the role
            };

            $.ajax({
                url: '/api/users/create', // API endpoint to create a user
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    alert('Rescuer created successfully');
                    // Clear form after success
                    $('#createRescuerForm')[0].reset();
                },
                error: function (xhr) {
                    // Safely access the responseText
                    let errorMessage = 'An error occurred while creating the rescuer.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        errorMessage = xhr.responseText;
                    }
                    alert('Error: ' + errorMessage);
                }
            });
        });

         // Initialize DataTable for Categories
    const table = $('#itemsTable').DataTable({
        ajax: {
            url: '/api/items',
            dataSrc: ''
        },
        columns: [
            { data: 'id' },
            { data: 'name' },
            { data: 'category' },
            { data: 'details' },
            { data: 'stock'},
            {
                data: null,
                render: function(data, type, row) {
                    return `
                        <i class="fas fa-edit edit-category" data-id="${row.id}" title="Edit"></i>
                        <i class="fas fa-trash delete-category" data-id="${row.id}" title="Delete"></i>
                    `;
                }
            }
        ],
        
        
    });

    

    // Handle Import JSON for Categories
    $('#importBtn').on('click', function() {
        const fileInput = $('#importFile')[0];
        if (fileInput.files.length === 0) {
            alert('Please select a file first.');
            return;
        }

        const formData = new FormData();
        formData.append('file', fileInput.files[0]);

        $.ajax({
            url: '/api/items/categories/import',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function(response) {
                alert(response.message);
                table.ajax.reload(); // Refresh the DataTable
            },
            error: function(xhr, status, error) {
                alert('Error importing data: ' + xhr.responseText);
            }
        });
    });

    // Handle Export JSON for Categories
    $('#exportBtn').on('click', function() {
        window.location.href = '/api/items/categories/export';
    });

    // Handle Edit and Delete operations
    $('#itemsTable').on('click', '.edit-category', function() {
        const id = $(this).data('id');
        console.log('Edit category with ID:', id);
        // Implement your edit functionality here
    });

    $('#itemsTable').on('click', '.delete-category', function() {
        const id = $(this).data('id');
        if (confirm('Are you sure you want to delete this category?')) {
            $.ajax({
                url: `/api/items/categories/${id}`,
                type: 'DELETE',
                success: function() {
                    table.ajax.reload(); // Refresh the DataTable
                },
                error: function(xhr, status, error) {
                    alert('Error deleting category: ' + xhr.responseText);
                }
            });
        }
    });
});
