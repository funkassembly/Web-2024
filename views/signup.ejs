<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="../styles/signupstyle.css">
    <title>Document</title>
    <link rel="icon" href="/maptry/icons/favicon.ico" type="image/x-icon">
    <!-- Load Leaflet first -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>

    <!-- Then load Esri Leaflet -->
    <script src="https://unpkg.com/esri-leaflet@2.3.3/dist/esri-leaflet.js"></script>

    <!-- Then load the Esri Leaflet Geocoder plugin -->
    <script src="https://unpkg.com/esri-leaflet-geocoder@2.3.2/dist/esri-leaflet-geocoder.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/esri-leaflet-geocoder@2.3.2/dist/esri-leaflet-geocoder.css" />

    
</head>
<body>

<% if (typeof error !== 'undefined') { %>
    <p style="color: red;"><%= error %></p>
<% } %>

<div class="background">
    <div class="shape"></div>
    <div class="shape"></div>
</div>

<div class="form-container">
    <form action="/signup" method="POST" class="form-left">
        <label for="username">Username</label>
        <input type="text" name="username" placeholder="Username" id="username" required />

        <label for="email">Email</label>
        <input type="email" name="email" placeholder="Email" id="email" required />

        <label for="cellphone">Cell Phone Number</label>
        <input type="text" name="cellphoneNumbeer" placeholder="Cellphone" id="cellphone" required />

        <label for="password">Password</label>
        <input type="password" name="password" placeholder="Password" id="password" required />

        <select name="role" style="display: none;">
            <option value="civilian">Civilian</option>
            <option value="rescuer">Rescuer</option>
        </select>

        <button type="submit">Sign Up</button>

        <div class="login-section">
            <p>Do you have an account? <a href="/login">Login</a></p>
        </div>
    </form>

    <form class="address-container">
        <label for="street">Street</label>
        <input type="text" name="street" placeholder="Street" id="street" required />

        <label for="number">Number</label>
        <input type="text" name="number" placeholder="Number" id="number" required />

        <label for="city">City</label>
        <input type="text" name="city" placeholder="City" id="city" required />

        <label for="country">Country</label>
        <input type="text" name="country" placeholder="Country" id="country" required />

        <label for="zip">Zip Code</label>
        <input type="text" name="zip" placeholder="Zip Code" id="zip" required />
    </form>
</div>

<script>
    // Function to use Geolocation API and Reverse Geocoding
    function detectLocation() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(successCallback, errorCallback);
        } else {
            alert("Geolocation is not supported by this browser.");
        }
    }

    function successCallback(position) {
        const latitude = position.coords.latitude;
        const longitude = position.coords.longitude;
        console.log(`Latitude: ${latitude}, Longitude: ${longitude}`);

        // Use ESRI Geocoder to reverse geocode coordinates to an address
        const geocodeService = L.esri.Geocoding.geocodeService();

        geocodeService.reverse().latlng([latitude, longitude]).run(function (error, result) {
            if (error) {
                alert("Unable to retrieve address.");
                return;
            }

            // Extract the full address
            const fullAddress = result.address.Address || '';
            const city = result.address.City || '';
            const zip = result.address.Postal || '';
            const country = result.address.CountryCode || '';

            // Split the full address to separate street name and number
            // Assuming the street number is at the beginning, followed by the street name
            const addressParts = fullAddress.split(' ');
            const streetName = addressParts[0]; // The rest is the street name
            const streetNumber = addressParts[1]; // The first part is usually the number

            // Ask user to confirm the detected address
            const userConfirmed = confirm(`Is this your correct address?\nStreet: ${streetName}\nNumber: ${streetNumber}\nCity: ${city}\nPostal Code: ${zip}\nCountry: ${country}`);
            if (userConfirmed) {
                // Fill form fields with detected address
                document.getElementById('street').value = streetName;
                document.getElementById('number').value = streetNumber;
                document.getElementById('city').value = city;
                document.getElementById('zip').value = zip;
                document.getElementById('country').value = country;
            }
        });
    }

    function errorCallback(error) {
        console.error(error);
        alert("Error occurred while retrieving your location.");
    }

    // Run the location detection when the page loads
    window.onload = detectLocation;
</script>

</body>
</html>