<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rescuer's Dashboard</title>
    <link rel="stylesheet" href="/styles/rescuerDashboard.css">
    <link rel="icon" href="/maptry/icons/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <style>
        #map {
            width: 100%;
            height: 100vh; /* Fill the entire iframe */
        }
    </style>
</head>
<body>

    <div class="header-links">
        <a href="#" id="instructionsLink" class="left-link">Οδηγίες</a>
        <a href="/logout" class="right-link">Logout</a>
    </div>

    <!-- Instructions Modal -->
    <div id="instructionsModal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <h2>Οδηγίες</h2>
            <p>1. Σύρε το όχημα <img src="maptry/icons/transport.png" style="width: 3%; height: 3%;"> στην Τοποθεσία σου.</p>
            <p>2. Επέλεξε το κουμπί 'Φόρτωση' ή 'Εκφόρτωση' όταν βρίσκεσαι σε απόσταση μέχρι 100m από τη Γενική Αποθήκη για την παραλαβή προμηθειών.</p>
            <p>3. Επέλεξε μέχρι 4 πολίτες <img src="maptry/icons/peoplePending.png" style="width: 3%; height: 3%;"> για να εξυπηρετήσεις.</p>
            <p>4. Για να επιθεωρήσεις το τρέχον φορτίο του οχήματος επέλεξε το κουμπί 'Τρέχον Φορτίο'.</p>
            <p>5. Υπομνήματα Χάρτη: </p>
            <p>    *<img src="maptry/icons/medical.png" style="width: 2%; height: 2%;">: Ιατρικά Αγαθά</p>
            <p>    *<img src="maptry/icons/food.png" style="width: 2%; height: 2%;">: Φαγητό</p>
            <p>    *<img src="maptry/icons/shelter.png" style="width: 2%; height: 2%;">: Εξοπλισμός Στέγασης</p>
            <p>    *<img src="maptry/icons/donate.png" style="width: 2%; height: 2%;">: Δωρεά Αγαθών</p>
        </div>
    </div>

    <!-- Modal for Displaying Products -->
    <div id="productModal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <div class="modal-buttons">
                <button id="loadButton" class="inactive">Φόρτωση</button>
            </div>
            <h2>Available Products in General Storage</h2>
            <div class="product-list">
                <table id="productTable">
                    <!-- Table will be populated by JavaScript -->
                </table>
            </div>
        </div>
    </div>

    <h1>Dashboard Διασώστη</h1>
    <div class="dashboard-container">
        
        <div class="map-container">
            <div id="map"></div>
        </div>

        <div class="cargo-container">
            <!-- Tabs for switching between Cargo and Tasks -->
            <div class="tabs">
                <button id="cargoTabBtn" class="button-active" onclick="openTab('cargoTab', this)">Cargo</button>
                <button id="taskTabBtn" class="button-inactive" onclick="openTab('tasksTab', this)">Tasks</button>

            </div>
        
            <!-- Content for Cargo tab -->
            <div id="cargoTab" class="tab-content active">
                <button id="unloadButton" class="inactive">Εκφόρτωση</button>
                <div id="loadedProducts"></div> <!-- Placeholder for loaded products -->
            </div>
        
            <!-- Content for Tasks tab -->
            <div id="tasksTab" class="tab-content">
                <h3>Your tasks will appear here.</h3>
                <!-- Add any additional content for tasks here -->
            </div>
        </div>

        <button id="filterToggleButton" class="filter-button">Φίλτρα Χάρτη</button>

        <div id="filters" class="filter-container">
            <h3>Εξυπηρέτηση</h3>
            
            <label>
                <input type="checkbox" class="main-filter" value="pending"> Πολίτες εν Αναμονή
            </label>
            <label>
                <input type="checkbox" class="main-filter" value="served"> Πολίτες που Εξυπηρετούνται
            </label>

            <h4>Είδος Προϊόντος</h4>
            
            <label>
                <input type="checkbox" class="sub-filter" value="medical"> Ιατρικός Εξοπλισμός
            </label>
            <label>
                <input type="checkbox" class="sub-filter" value="food"> Φαγητό
            </label>
            <label>
                <input type="checkbox" class="sub-filter" value="shelter"> Εξοπλισμός Στέγασης
            </label>
            <label>
                <input type="checkbox" class="sub-filter" value="donate"> Προσφορά Αγαθών
            </label>
        </div>

        
        <script>
            
            document.addEventListener("DOMContentLoaded", function() {
                console.log('DOMContentLoaded event triggered');
                let popupContent = "some content"; // Example for other usage


                const map = L.map('map').setView([38.2462420, 21.7350847], 16);
            
                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
                }).addTo(map);

                (async function() {
                    try {
                        const response = await fetch('/getCiviliansWithActions');
                        const data = await response.json();

                        if (data.success) {
                            const civilians = data.civilians;

                            for (const civilian of civilians) {
                                if (civilian.location && Array.isArray(civilian.location.coordinates) && civilian.location.coordinates.length === 2) {
                                    const [lat, lng] = civilian.location.coordinates;

                                    // Determine the appropriate icon based on the action
                                    let icon = civilian.requests.length > 0 ? peoplePendingIcon : DonateIcon;

                                    // Fetch the username based on the civilian's _id
                                    let username = await fetchUsernameById(civilian._id);
                                    if (!username) username = 'Unknown';

                                    // Initialize popup content with username and action type
                                    let popupContent = `<strong>Username:</strong> ${username}<br>`;
                                    popupContent += `<strong>Action:</strong> ${civilian.requests.length > 0 ? 'Request' : 'Donation'}<br>`;
                                    popupContent += `<strong>Location:</strong> ${lat}, ${lng}<br>`;

                                    if (civilian.requests.length > 0) {
                                        popupContent += `<strong>Requests:</strong><br><ul>`;
                                        civilian.requests.forEach(request => {
                                            // Construct the full address
                                            const address = request.address;
                                            const fullAddress = `${address.street} ${address.number}, ${address.city}, ${address.postalcode}, ${address.country}`;
                                            
                                            // Add each product's information to the popup
                                            request.products.forEach(productObj => {
                                                const product = productObj.product;
                                                if (product) {
                                                    popupContent += `<li>Product: ${product.name}<br>`;
                                                    popupContent += `Category: ${product.category}<br>`;
                                                    popupContent += `Address: ${fullAddress}<br>`;
                                                    popupContent += `Requested on: ${request.date} at ${request.time}<br>`;
                                                    popupContent += `Delivery Date: ${request.deliveryDate || ''}<br>`;
                                                    popupContent += `Delivery Time: ${request.deliveryTimeSlot.hours}:${request.deliveryTimeSlot.minutes}</li><br>`;
                                                } else {
                                                    popupContent += `<li>Product: undefined<br></li>`;
                                                }
                                            });
                                        });
                                        popupContent += `</ul>`;
                                    } else if (civilian.donations.length > 0) {
                                        popupContent += `<strong>Donations:</strong><br><ul>`;
                                        civilian.donations.forEach(donation => {
                                            popupContent += `<li>Product: ${donation.product.name}<br>`;
                                            popupContent += `Category: ${donation.product.category}<br>`;
                                            popupContent += `Quantity: ${donation.product.details.find(detail => detail.name === 'stock')?.value || 'N/A'}<br>`;
                                            popupContent += `Donated on: ${donation.date} at ${donation.time}<br>`;
                                            popupContent += `Delivery Date: ${donation.deliveryDate}<br>`;
                                            popupContent += `Delivery Time: ${donation.deliveryTimeSlot.hours}:${donation.deliveryTimeSlot.minutes}</li><br>`;
                                        });
                                        popupContent += `</ul>`;
                                    }
                            

                                // Debugging output to ensure the popup content is correctly generated
                                console.log("Popup Content for civilian:", popupContent);

                                // Add a marker for the civilian with the pop-up
                                const marker = L.marker([lat, lng], { icon: icon }).addTo(map);
                                marker.bindPopup(popupContent);
                                }
                            }
                            
                        } else {
                            console.error('Failed to load civilians:', data.message);
                        }
                    
                    } catch (error) {
                        console.error('Error loading civilians:', error);
                    }
                })();

                async function fetchUsernameById(userId) {
                    try {
                        const response = await fetch(`/getUsernameById/${userId}`);
                        if (!response.ok) {
                            throw new Error('Failed to fetch username');
                        }
                        const data = await response.json();
                        return data.username || 'Unknown';
                    } catch (error) {
                        console.error('Error fetching username:', error);
                        return 'Unknown';
                    }
                }


                (async function() {
                    // Load rescuer's cargo from the database
                    try {
                        const response = await fetch('/getCargo', { method: 'GET' });
                        const data = await response.json();
                        if (data.success) {
                            populateCargoTab(data.cargo);
                        } else {
                            console.error('Failed to load cargo:', data.message);
                        }
                        const productsResponse = await fetch('/getProducts');
                        const products = await productsResponse.json();
                        renderProductModal(products);
                    } catch (error) {
                        console.error('Error loading cargo:', error);
                    }

                    var activeTabButton = document.getElementById('cargoTabBtn'); // Default to Cargo tab
                    if (activeTabButton) {
                        openTab('cargoTab', activeTabButton);
                    } else {
                        console.error('No tab buttons found');
                    }
                })();


                const StorageIcon = L.icon({
                    iconUrl: '/maptry/icons/Storage.png', 
                    iconSize: [30, 30],
                    iconAnchor: [15,8],
                    popupAnchor: [0, 0]
                });
                // Rescuer draggable marker
                const RescuerIcon = L.icon({
                    iconUrl: '/maptry/icons/transport.png',
                    iconSize: [35, 35],
                    iconAnchor: [15, 30],
                    popupAnchor: [0, -30]
                });

                var markerStorage = L.marker([38.24600, 21.73500], {icon: StorageIcon}).addTo(map);
                var markerRescuer = L.marker([38.24600, 21.73500], {icon: RescuerIcon, draggable: true}).addTo(map);
                markerRescuer.bindPopup('Σύρε με στην τοποθεσία σου!').openPopup();

                markerStorage.on('click', async function() {
                const distance = calculateDistance(markerStorage.getLatLng(), markerRescuer.getLatLng());
                if (distance <= 100) {
                    try {
                        const response = await fetch('/getProducts');
                        if (!response.ok) {
                            throw new Error('Failed to fetch products');
                        }
                        const products = await response.json();
            
                        // Send a message to the parent document to show the modal and populate it
                        window.parent.postMessage({
                            type: 'showProductModal',
                            products: products
                        }, '*');
                    } catch (error) {
                        console.error('Error fetching or displaying products:', error);
                    }
                }
                });

                // Function to calculate the distance between two LatLng points in meters
                function calculateDistance(latlng1, latlng2) {
                    return map.distance(latlng1, latlng2);
                }
                
                // Function to update the Unload button state based on distance
                function updateUnloadButtonState() {
                    const storageLatLng = markerStorage.getLatLng();
                    const rescuerLatLng = markerRescuer.getLatLng();
                
                    const distance = calculateDistance(storageLatLng, rescuerLatLng);
                
                    // Send a message to the parent window with the distance info to enable/disable the Unload button
                    window.parent.postMessage({
                        type: 'updateUnloadButtonState',
                        distance: distance
                    }, '*');
                }
                
                // Initially set the Unload button state based on the initial position
                updateUnloadButtonState();
                
                // Update Unload button state whenever the rescuer marker is dragged
                markerRescuer.on('drag', function() {
                    updateUnloadButtonState();
                });

                // Event listener for when the marker is dragged and dropped
                markerRescuer.on('dragend', function(event) {
                    var position = markerRescuer.getLatLng();
                    console.log('Rescuer\'s location: ', position.lat, position.lng);
                
                    // Send an AJAX request to update the rescuer's location in the database
                    fetch('/updateRescuerLocation', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ lat: position.lat, lng: position.lng })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            console.log('Location updated successfully.');
                        } else {
                            console.error('Failed to update location:', data.error);
                        }
                    })
                    .catch(error => console.error('Error:', error));
                });

                const modals = document.querySelectorAll('.modal');
                const closeButtons = document.querySelectorAll('.close-modal');
                addCheckboxEventListeners();
                observeCheckboxes();

                // Open Instructions Modal
                document.getElementById('instructionsLink').addEventListener('click', function(event) {
                    event.preventDefault();
                    document.getElementById('instructionsModal').style.display = "block";
                });

                // Close modals
                closeButtons.forEach(closeBtn => {
                    closeBtn.addEventListener('click', function() {
                        closeBtn.closest('.modal').style.display = 'none';
                    });
                });

                // Close modals when clicking outside of the modal content
                window.addEventListener('click', function(event) {
                    modals.forEach(modal => {
                        if (event.target == modal) {
                            modal.style.display = "none";
                        }
                    });
                });

                const filterToggleButton = document.getElementById('filterToggleButton');
                const filterContainer = document.getElementById('filters');

                // Toggle filter visibility on button click
                filterToggleButton.addEventListener('click', function() {
                    filterContainer.classList.toggle('visible');
                });

                // Initially check the desired filters
                document.querySelectorAll('.main-filter[value="pending"], .sub-filter[value="medical"], .sub-filter[value="food"], .sub-filter[value="shelter"], .sub-filter[value="donate"]').forEach(cb => {
                    cb.checked = true;
                });

                // Handle messages from the iframe
                window.addEventListener('message', function(event) {
                    if (event.data.type === 'updateUnloadButtonState') {
                        const unloadButton = document.getElementById('unloadButton');
                        const distance = event.data.distance;

                        if (unloadButton) {
                            if (distance <= 100) {
                                unloadButton.classList.remove('inactive');
                                unloadButton.classList.add('active');
                                unloadButton.disabled = false;
                            } else {
                                unloadButton.classList.remove('active');
                                unloadButton.classList.add('inactive');
                                unloadButton.disabled = true;
                            }
                        } else {
                            console.log('Unload button not found in the DOM');
                        }
                    }

                    if (event.data.type === 'showProductModal') {
                        const products = event.data.products;

                        const productModal = document.getElementById('productModal');
                        if (!productModal) {
                            console.error('productModal element not found');
                            return;
                        }

                        const productTable = document.getElementById('productTable');
                        if (!productTable) {
                            console.error('productTable element not found');
                            return;
                        }
                        console.log('productTable found:', productTable);

                        renderProductModal(products);
                        productModal.style.display = 'block';
                    }

                    if (event.data.type === 'loadCiviliansMarkers') {
                        const civilians = event.data.civilians;
                        console.log("Civilians Data:", civilians); // Debugging line

                        civilians.forEach(civilian => {
                            const [lat, lng] = civilian.location.coordinates;

                            // Choose the appropriate icon based on whether it's a request or donation
                            let icon = civilian.requests.length > 0 ? peoplePendingIcon : DonateIcon;

                            

                            // Optionally bind a popup with more details
                            let popupContent = `<strong>Action:</strong> ${civilian.requests.length > 0 ? 'Request' : 'Donation'}<br>`;
                            popupContent += `<strong>Location:</strong> ${lat}, ${lng}<br>`;

                            if (civilian.requests.length > 0) {
                                // Add request details
                                popupContent += `<strong>Requests:</strong><br><ul>`;
                                civilian.requests.forEach(request => {
                                    popupContent += `<li>${request.item}: ${request.quantity}</li>`;
                                });
                                popupContent += `</ul>`;
                            } else if (civilian.donations.length > 0) {
                                // Add donation details
                                popupContent += `<strong>Donations:</strong><br><ul>`;
                                civilian.donations.forEach(donation => {
                                    popupContent += `<li>${donation.item}: ${donation.quantity}</li>`;
                                });
                                popupContent += `</ul>`;
                            }
                            console.log("Popup Content:", popupContent); // Debugging line
                            // Add a marker for each civilian
                            const marker = L.marker([lat, lng], { icon: icon }).addTo(map);
                            marker.bindPopup(popupContent);
                        });
                    }
                });

                // Add event listeners for live filtering
                document.querySelectorAll('.main-filter, .sub-filter').forEach(cb => {
                    cb.addEventListener('change', function() {
                        const activeMainFilters = Array.from(document.querySelectorAll('.main-filter:checked')).map(cb => cb.value);
                        const activeSubFilters = Array.from(document.querySelectorAll('.sub-filter:checked')).map(cb => cb.value);
                        iframeWindow.applyFilters(activeMainFilters, activeSubFilters);
                    });
                });

                

            }); 

            // Markers Init
            const FoodIcon = L.icon({
                iconUrl: '/maptry/icons/food.png',
                iconSize: [20, 20],
                iconAnchor: [15, 30],
                popupAnchor: [0, -30]
            });
            const MedicalIcon = L.icon({
                iconUrl: '/maptry/icons/medical.png',
                iconSize: [20, 20],
                iconAnchor: [15, 30],
                popupAnchor: [0, -30]
            });
            const ShelterIcon = L.icon({
                iconUrl: '/maptry/icons/shelter.png',
                iconSize: [20, 20],
                iconAnchor: [15, 30],
                popupAnchor: [0, -30]
            });
            const DonateIcon = L.icon({
                iconUrl: '/maptry/icons/donate.png',
                iconSize: [20, 20],
                iconAnchor: [15, 30],
                popupAnchor: [0, -30]
            });
            const peoplePendingIcon = L.icon({
                iconUrl: '/maptry/icons/peoplePending.png',
                iconSize: [30, 30],
                iconAnchor: [15, 30],
                popupAnchor: [0, -30]
            });
            const peopleServedIcon = L.icon({
                iconUrl: '/maptry/icons/peopleServed.png',
                iconSize: [30, 30],
                iconAnchor: [15, 30],
                popupAnchor: [0, -30]
            });
         
            
            function createCombinedIcon(mainCategoryIconUrl, subCategoryIconUrl) {
                return L.divIcon({
                    html: `
                        <div style="position: relative; width: 30px; height: 30px;">
                            <img src="${mainCategoryIconUrl}" style="width: 100%; height: 100%;">
                            <img src="${subCategoryIconUrl}" style="width: 15px; height: 15px; position: absolute; top: 0; right: 0;">
                        </div>
                    `,
                    className: ''
                });
            }
            

            function openTab(tabName, element) {
                console.log('openTab called with tabName:', tabName);

                var i, tabcontent, tabbuttons;

                // Hide all tab content
                tabcontent = document.getElementsByClassName("tab-content");
                for (i = 0; i < tabcontent.length; i++) {
                    tabcontent[i].style.display = "none";
                    tabcontent[i].classList.remove('active');
                }

                // Remove the active class from all tab buttons
                tabbuttons = document.querySelectorAll("#cargoTabBtn, #taskTabBtn");
                for (i = 0; i < tabbuttons.length; i++) {
                    tabbuttons[i].classList.remove("button-active");
                    tabbuttons[i].classList.add("button-inactive");
                }

                // Show the specific tab content
                var tabContentElement = document.getElementById(tabName);
                if (tabContentElement) {
                    tabContentElement.style.display = "block";
                    tabContentElement.classList.add('active');
                } else {
                    console.error('Tab content element not found for:', tabName);
                }

                // Add the active class to the button that opened the tab
                if (element) {
                    element.classList.add("button-active");
                    element.classList.remove("button-inactive");
                } else {
                    console.error('Element is undefined in openTab function');
                }
            }
            

            function createCargoRow(item) {
                const { productId, quantity } = item;
                console.log('ProductId:', productId);
                console.log('Product Details:', productId ? productId.details : 'No details available');


                return `<tr>
                    <td><input type="checkbox" class="product-checkbox" data-product-id="${productId._id}"></td>
                    <td>${productId.name}</td>
                    <td>${productId.category}</td>
                    <td>${productId.details.map(detail => `${detail.detail_name}: ${detail.detail_value}`).join(', ')}</td>
                    <td class="quantity-cell">${quantity}</td>
                </tr>`;
            }

            function populateCargoTab(cargo) {
                if (!Array.isArray(cargo)) {
                    console.error('Cargo is not an array or is undefined:', cargo);
                    return;
                }
                const cargoTab = document.getElementById('cargoTab');

                const loadedProductsDiv = document.getElementById('loadedProducts');
                
                let productTableHtml = `
                    <table id="productTable">
                        <thead>
                            <tr>
                                <th> # </th>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th>Details</th>
                                <th>Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                `;

                cargo.forEach(item => {
                    productTableHtml += createCargoRow(item);
                });

                productTableHtml += '</tbody></table>';
                loadedProductsDiv.innerHTML = productTableHtml;
            
                addCheckboxEventListeners();
            }

            function addCheckboxEventListeners() {
                document.querySelectorAll('.product-checkbox').forEach(checkbox => {
                    checkbox.addEventListener('change', function() {
                        const row = this.closest('tr');
                        const quantityCell = row.querySelector('.quantity-cell');

                        if (!quantityCell) {
                            console.error('Quantity cell not found for row:', row);
                            return;
                        }

                        let quantity = parseInt(quantityCell.textContent, 10);
                        if (isNaN(quantity)) {
                            console.warn('Parsed quantity is NaN, defaulting to 0');
                            quantity = 0;
                        }

                        if (this.checked) {
                            // Replace quantity text with an input field and buttons
                            quantityCell.innerHTML = `
                                <input type="number" class="quantity-input" value="${quantity}" min="0" style="width: 50px;">
                                <button class="increment-btn">+</button>
                                <button class="decrement-btn">-</button>
                            `;

                            // Add event listeners to the increment and decrement buttons
                            const incrementBtn = quantityCell.querySelector('.increment-btn');
                            const decrementBtn = quantityCell.querySelector('.decrement-btn');
                            const quantityInput = quantityCell.querySelector('.quantity-input');

                            incrementBtn.addEventListener('click', function() {
                                let currentQuantity = parseInt(quantityInput.value, 10);
                                quantityInput.value = currentQuantity + 1;
                            });

                            decrementBtn.addEventListener('click', function() {
                                let currentQuantity = parseInt(quantityInput.value, 10);
                                if (currentQuantity > 0) {
                                    quantityInput.value = currentQuantity - 1;
                                }
                            });

                        } else {
                            // Restore the original quantity text
                            quantityCell.innerHTML = quantity;
                        }
                    });
                });
            }
            
            function observeCheckboxes() {
                document.addEventListener("DOMContentLoaded", function() {
                    const targetNode = document.querySelector('#loadedProducts tbody'); // Assuming checkboxes are within <tbody>
                      
                    if (!targetNode) {
                        console.error("Target node (tbody) not found. Ensure it exists before observing.");
                        return;
                    }

                    const config = { childList: true, subtree: true };

                    const callback = function(mutationsList) {
                        for (let mutation of mutationsList) {
                            if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
                                addCheckboxEventListeners();
                            }
                        }
                    };

                    const observer = new MutationObserver(callback);
                    observer.observe(targetNode, config);
                });
            }


            function renderProductModal(products) {
                    
                const productTable = document.getElementById('productTable');
                productTable.innerHTML = '<tr><th>Product Name</th><th>Category</th><th>Details</th><th>Stock</th><th>Quantity</th><th>Actions</th></tr>';

                products.forEach(product => {
                    const row = productTable.insertRow();
                    row.dataset.productId = product._id;
                    row.insertCell(0).innerText = product.name;
                    row.insertCell(1).innerText = product.category;
                    row.insertCell(2).innerText = product.details.map(detail => `${detail.detail_name}: ${detail.detail_value}`).join(', ');
                    row.insertCell(3).innerText = product.stock;

                    // Create the quantity input field
                    const quantityCell = row.insertCell(4);
                    const quantityInput = document.createElement('input');
                    quantityInput.type = 'number';
                    quantityInput.value = 0;
                    quantityInput.min = 0;
                    quantityInput.max = product.stock;
                    quantityInput.style.width = '50px';
                    quantityCell.appendChild(quantityInput);

                    // Create the + and - buttons
                    const actionsCell = row.insertCell(5);
                    const incrementButton = document.createElement('button');
                    incrementButton.innerText = '+';
                    incrementButton.addEventListener('click', function () {
                        let currentQuantity = parseInt(quantityInput.value);
                        if (currentQuantity < product.stock) {
                            quantityInput.value = currentQuantity + 1;
                        }
                    });

                    const decrementButton = document.createElement('button');
                    decrementButton.innerText = '-';
                    decrementButton.addEventListener('click', function () {
                        let currentQuantity = parseInt(quantityInput.value);
                        if (currentQuantity > 0) {
                            quantityInput.value = currentQuantity - 1;
                        }
                    });
                    actionsCell.appendChild(incrementButton);
                    actionsCell.appendChild(decrementButton);
            }
            )}
            // Handle Load Button
            document.getElementById('loadButton').addEventListener('click', async function() {
                    const cargoTab = document.getElementById('cargoTab');
                    const rows = document.querySelectorAll('#productModal table tbody tr');
                    let cargo = [];

                    rows.forEach((row, index) => {
                        if (index === 0) return; // Skip header row
                        const quantityInput = row.querySelector('input[type="number"]');
                        if (quantityInput) {
                            const quantity = parseInt(quantityInput.value);
                            console.log('Quantity input found:', quantityInput, 'with value:', quantity); // Debugging line
                            
                            if (quantity > 0) {
                                const productId = row.dataset.productId;
                                if (productId) {
                                    cargo.push({ productId: productId, quantity: quantity });
                                } else {
                                    console.warn('No productId found for row:', row); // Debugging aid
                                }
                            } else {
                                console.warn('Quantity is zero or less for row:', row); // Debugging aid
                            }
                        } else {
                            console.warn('No quantity input found for row:', row); // Debugging aid
                        }
                    });

                    // Save cargo to the database via an AJAX request
                    try {
                        const response = await fetch('/saveCargo', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ cargo: cargo })
                        });
                        const responseText = await response.text();  // Get the raw response text
                        console.log('Raw response text:', responseText);  // Log it for debugging
                        // Attempt to parse the response as JSON
                        const data = JSON.parse(responseText);
                        console.log('Cargo saved successfully:', data);

                        // Fetch updated products to reflect the new stock
                        const productsResponse = await fetch('/getProducts');
                        const updatedProducts = await productsResponse.json();

                        // Re-render the product modal with updated stock
                        renderProductModal(updatedProducts);
                        // populateCargoTab(cargo);
                    
        
                        let tableBody = document.querySelector('#loadedProducts table tbody');
                        
                        // If the table doesn't exist, create it with headers
                        if (!tableBody) {
                            let loadedProductsHtml = '<h3>Loaded Products:</h3>';
                            loadedProductsHtml += '<table><thead><tr><th> # </th><th>Product Name</th><th>Category</th><th>Details</th><th>Quantity</th></tr></thead><tbody>';
                            document.getElementById('loadedProducts').innerHTML = loadedProductsHtml;
                            tableBody = document.querySelector('#loadedProducts table tbody');
                        }
                            
                        
                        // Append each new product as a row
                        cargo.forEach(item => {
                            const row = Array.from(rows).find(row => row.dataset.productId === item.productId);
                            if (row) {
                                const productName = row.cells[0].innerText;
                                const productCategory = row.cells[1].innerText;
                                const productDetails = row.cells[2].innerText;

                                const newRowHtml = `<tr>
                                    <td><input type="checkbox" class="product-checkbox" data-product-id="${item.productId}"></td>
                                    <td>${productName}</td>
                                    <td>${productCategory}</td>
                                    <td>${productDetails}</td>
                                    <td>${item.quantity}</td>
                                </tr>`;
                                
                                tableBody.insertAdjacentHTML('beforeend', newRowHtml); // Append the new row
                            } else {
                                console.warn('No matching row found for productId:', item.productId);  // Debugging aid
                            }
                        });
                        
                        


                        // Optionally, close the modal after loading products
                        document.getElementById('productModal').style.display = 'none';

                 } catch (error) {
                        console.error('Error saving cargo:', error);
                    }
                

                });
            
            document.getElementById('unloadButton').addEventListener('click', async function () {
                const selectedItems = [];

                // Iterate over each row in the cargo table
                document.querySelectorAll('#loadedProducts tr').forEach(row => {
                    const checkbox = row.querySelector('.product-checkbox');
                    const quantityInput = row.querySelector('.quantity-input');

                    if (checkbox && checkbox.checked && quantityInput) {
                        const quantityToReturn = parseInt(quantityInput.value, 10) || 0;
                        if (quantityToReturn > 0) {
                            const productId = checkbox.dataset.productId;
                            selectedItems.push({
                                productId,
                                quantity: quantityToReturn
                            });
                        }
                    }
                });

                if (selectedItems.length === 0) {
                    alert('No products selected or quantity is zero.');
                    return;
                }

                try {
                    const response = await fetch('/unloadCargo', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ items: selectedItems })
                    });

                    const result = await response.json();
                    if (result.success) {
                        alert('Products unloaded successfully!');

                        // Refresh the cargo and product modals to reflect the changes
                        const cargoResponse = await fetch('/getCargo');
                        const cargoData = await cargoResponse.json();
                        populateCargoTab(cargoData.cargo);

                        const productsResponse = await fetch('/getProducts');
                        const productsData = await productsResponse.json();
                        renderProductModal(productsData);
                    } else {
                        alert('Failed to unload products: ' + result.message);
                    }
                } catch (error) {
                    console.error('Error unloading cargo:', error);
                    alert('An error occurred while unloading cargo.');
                }
            });

        </script>

    </body>
</html>
