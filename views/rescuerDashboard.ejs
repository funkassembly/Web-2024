                        alert('Failed to serve requests: ' + data.message);
                    }
                } catch (error) {
                    console.error('Error serving requests:', error);
                    alert('An error occurred while serving the requests.');
                }
            }

            // Helper function to convert degrees to radians
            function toRadians(degrees) {
                return degrees * Math.PI / 180;
            }

            // Helper function to convert radians to degrees
            function toDegrees(radians) {
                return radians * 180 / Math.PI;
            }

            // Function to generate random latitude and longitude within a radius
            function getRandomLocation(lat, lng, radius) {
                const earthRadius = 6371000; // Earth's radius in meters

                // Convert radius from meters to degrees
                const radiusInDegrees = radius / earthRadius;

                // Random distance and angle for the point within the circle
                const distance = Math.random() * radiusInDegrees;
                const angle = Math.random() * 2 * Math.PI;

                // Calculate the new latitude and longitude
                const newLat = Math.asin(Math.sin(toRadians(lat)) * Math.cos(distance) +
                            Math.cos(toRadians(lat)) * Math.sin(distance) * Math.cos(angle));

                const newLng = toRadians(lng) + Math.atan2(Math.sin(angle) * Math.sin(distance) * Math.cos(toRadians(lat)),
                            Math.cos(distance) - Math.sin(toRadians(lat)) * Math.sin(newLat));

                return {
                    lat: toDegrees(newLat),
                    lng: toDegrees(newLng)
                };
            }

            // Functions to manage waypoints for routing ****
            function addWaypointAndRefreshRoute(waypoint) {
                taskWaypoints.push(waypoint);
                displayRouteForAllTasks();  // Refresh the route with updated waypoints
            }

            function removeWaypointAndRefreshRoute(coordinates) {
                const [lat, lng] = coordinates;
                taskWaypoints = taskWaypoints.filter(wp => !(wp.lat === lat && wp.lng === lng));
                displayRouteForAllTasks();  // Refresh the route
            }

            document.querySelectorAll('.task-row').forEach(row => {
                row.addEventListener('click', function() {
                    // Toggle the corresponding details row visibility
                    const detailsRow = this.nextElementSibling;
                    if (detailsRow && detailsRow.classList.contains('task-details-row')) {
                        detailsRow.style.display = (detailsRow.style.display === 'none' || detailsRow.style.display === '') ? 'table-row' : 'none';
                    }
                });
            });
            
