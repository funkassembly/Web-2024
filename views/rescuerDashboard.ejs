                // Show the specific tab content
                var tabContentElement = document.getElementById(tabName);
                if (tabContentElement) {
                    tabContentElement.style.display = "block";
                    tabContentElement.classList.add('active');
                } else {
                    console.error('Tab content element not found for:', tabName);
                }

                // Add the active class to the button that opened the tab
                if (element) {
                    element.classList.add("button-active");
                    element.classList.remove("button-inactive");
                } else {
                    console.error('Element is undefined in openTab function');
