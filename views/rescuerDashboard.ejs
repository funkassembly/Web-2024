<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rescuer's Dashboard</title>
    <link rel="stylesheet" href="/styles/rescuerDashboard.css">
</head>
<body>

<h1>Rescuer's Dashboard</h1>
<div class="dashboard-container">
    <div class="map-container">
        <iframe src="/maptry/ranmap.html" width="100%" height="100%" frameborder="0"></iframe>
    </div>
    <div class="cargo-container">
        <button id="cargoButton">Cargo</button>
        <h3>Requests / Donations</h3>
        <div id="requestsDonations"></div>
    </div>
</div>

<div class="header-links">
    <a href="/logout">Logout</a>
    <a href="#" id="instructionsLink">Instructions</a>
</div>
<!-- The Modal -->
<div id="instructionsModal" class="modal">
    <!-- Modal content -->
    <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Instructions</h2>
        <p>Here you can provide detailed instructions for the rescuer on how to use the dashboard, drag and drop the marker, etc.</p>
        <!-- Add more instructional content as needed -->
    </div>
</div>

<script>
    document.getElementById('cargoButton').addEventListener('click', function() {
        alert('Cargo button clicked!');
    });
    
</script>

</body>
</html>
