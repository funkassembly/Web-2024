            async function serveSelectedRequests(civilianId) {
                const selectedRequestIds = Array.from(document.querySelectorAll('.request-checkbox:checked')).map(cb => cb.getAttribute('data-request-id'));

                if (selectedRequestIds.length === 0) {
                    alert('Please select at least one request to serve.');
                    return;
                }

                try {
                    const response = await fetch('/serveSelectedRequests', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ civilianId, selectedRequestIds })
                    });

                    const data = await response.json();
                    if (data.success) {
                        alert('Requests served successfully!');
