        <script>
            let markerRescuer;
            document.addEventListener("DOMContentLoaded", function() {
                console.log('DOMContentLoaded event triggered');
                

                // Add event listeners to static task table rows ****
                const taskRows = document.querySelectorAll('#tasksTable tbody tr');

                taskRows.forEach(row => {
                    const deleteButton = row.querySelector('.delete-button');
                    const checkmarkButton = row.querySelector('.checkmark-button');
                    const taskCheckbox = row.querySelector('.task-checkbox');

                    // Delete button click event
                    deleteButton.addEventListener('click', function () {
                        if (confirm('Are you sure you want to delete this task?')) {
                            row.remove();  // Remove the row from the table
                        }
                    });

                    // Checkmark button click event
                    checkmarkButton.addEventListener('click', function () {
                        alert('Task has been marked as completed!');
                    });

                    // Task checkbox change event for route display
                    taskCheckbox.addEventListener('change', function () {
                        if (this.checked) {
                            // Assuming a static location for demo purposes; replace with actual coordinates if available
                            const taskLocation = { lat: 38.246, lng: 21.735 };
                            addWaypointAndRefreshRoute(L.latLng(taskLocation.lat, taskLocation.lng));  // Add waypoint and refresh route
                        } else {
                            // Remove waypoint if unchecked
                            removeWaypointAndRefreshRoute([38.246, 21.735]);  // Remove waypoint from route
                        }
                    });
                }); // ****
                


                let popupContent = "some content"; // Example for other usage

                // General storage coordinates
                // const storageLat = 38.24600;
                // const storageLng = 21.73500;

                // // Generate a random location 5km around the general storage
                // const randomLocation = getRandomLocation(storageLat, storageLng, 5000); // 5000 meters = 5km

                // const map = L.map('map').setView([randomLocation.lat, randomLocation.lng], 15);

                const map = L.map('map').setView([38.2462420, 21.7350847], 16);
            
                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
                }).addTo(map);

                fetchTasks(); 
                

                (async function() {
                    try {
                        const response = await fetch('/getCiviliansWithActions');
                        const data = await response.json();

                        if (data.success) {
                            const civilians = data.civilians;

                            for (const civilian of civilians) {
                                if (civilian.location && Array.isArray(civilian.location.coordinates) && civilian.location.coordinates.length === 2) {
                                    const [lng, lat] = civilian.location.coordinates;

                                    // Determine the appropriate icon based on the action
                                    let icon = civilian.requests.length > 0 ? peoplePendingIcon : DonateIcon;

                                    // Fetch the username based on the civilian's _id
                                    let username = await fetchUsernameById(civilian._id);
                                    if (!username) username = 'Unknown';

                                    // Initialize popup content with username and action type
                                    let popupContent = `<strong>Username:</strong> ${username}<br>`;
                                    popupContent += `<strong>Action:</strong> ${civilian.requests.length > 0 ? 'Request' : 'Donation'}<br>`;
                                    popupContent += `<strong>Location:</strong> ${lng}, ${lat}<br>`;

                                    if (civilian.requests.length > 0) {
                                        popupContent += `<strong>Requests:</strong><br><ul>`;
                                        civilian.requests.forEach(request => {
                                            // Construct the full address
                                            const address = request.address;
                                            const fullAddress = `${address.street} ${address.number}, ${address.city}, ${address.postalcode}, ${address.country}`;
                                            
                                            // Add each product's information to the popup
                                            request.products.forEach(productObj => {
                                                const product = productObj.product;
                                                if (product) {
                                                    popupContent += `
                                                        <li>
                                                            <input type="checkbox" class="request-checkbox">
                                                            
                                                        `;
                                                    popupContent += `Product: ${product.name}<br>`;
                                                    popupContent += `Category: ${product.category}<br>`;
                                                    popupContent += `Address: ${fullAddress}<br>`;
                                                    popupContent += `Requested on: ${request.date} at ${request.time}<br>`;
                                                    popupContent += `Delivery Date: ${request.deliveryDate || ''}<br>`;
                                                    popupContent += `Delivery Time: ${request.deliveryTimeSlot.hours}:${request.deliveryTimeSlot.minutes}<br>`;
                                                    popupContent += `Status: {request.status}</li><br>`;
                                                } else {
                                                    popupContent += `<li>Product: undefined<br></li>`;
                                                }
                                            });
                                        });
                                        popupContent += `</ul>`;
                                    } else if (civilian.donations.length > 0) {
                                        popupContent += `<strong>Donations:</strong><br><ul>`;
                                        civilian.donations.forEach(donation => {
                                            popupContent += `<li>Product: ${donation.product.name}<br>`;
                                            popupContent += `Category: ${donation.product.category}<br>`;
                                            popupContent += `Quantity: ${donation.product.details.find(detail => detail.name === 'stock')?.value || 'N/A'}<br>`;
                                            popupContent += `Donated on: ${donation.date} at ${donation.time}<br>`;
                                            popupContent += `Delivery Date: ${donation.deliveryDate}<br>`;
                                            popupContent += `Delivery Time: ${donation.deliveryTimeSlot.hours}:${donation.deliveryTimeSlot.minutes}<br>`;
                                            popupContent += `Status: {request.status}</li><br>`;
                                        });
                                        popupContent += `</ul>`;
                                    }
                            
                                // Add the "Serve" button at the bottom of the popup
                                popupContent += `<button onclick="serveRequest('${civilian._id}', '${civilian.requests.length > 0 ? 'request' : 'donation'}')">Serve</button>`;

                                // Debugging output to ensure the popup content is correctly generated
                                // console.log("Popup Content for civilian:", popupContent);

                                // Add a marker for the civilian with the pop-up
                                const marker = L.marker([lng, lat], { icon: icon }).addTo(map);
                                marker.setIcon(peopleServedIcon);
                                marker.bindPopup(popupContent);
                                }
                            }
                            
                        } else {
                            console.error('Failed to load civilians:', data.message);
                        }
                    
                    } catch (error) {
                        console.error('Error loading civilians:', error);
                    }
                    // dummy markers
                    
                    const marker2 = L.marker([38.25245743373403, 21.73902358206551], { icon: peoplePendingIcon }).addTo(map);
                    const marker3 = L.marker([38.241786654079725, 21.740699091799787], { icon: peoplePendingIcon }).addTo(map);
                    const marker1 = L.marker([38.24852721101361, 21.73745869709119], { icon: peoplePendingIcon }).addTo(map);
                    
                    const markerDon1 = L.marker([38.253, 21.742], { icon: DonateIcon}).addTo(map);
                    
                    const popupContentDon1 = `
                        <table>
                            <tr><td><strong>Type:</strong><td>Donation</td></tr>
                            <tr><td><strong>Name:</strong></td><td>John Doe</td></tr>
                            <tr><td><strong>Cell Phone:</strong></td><td>6932859010</td></tr>
                            <tr><td><strong>Date Submitted:</strong></td><td>15/09/2024</td></tr>
                            <tr><td><strong>Product:</strong></td><td>Water</td></tr>
                            <tr><td><strong>Quantity:</strong></td><td>2</td></tr>
                            <tr><td colspan="2"><button type="button">Serve</button></td></tr>
                        </table>
                    `;
                    const popupContent1 = `
                        <table>
                            <tr><td><strong>Type:</strong><td>Request</td></tr>
                            <tr><td><strong>Name:</strong></td><td>Jane Doe</td></tr>
                            <tr><td><strong>Cell Phone:</strong></td><td>69458212210</td></tr>
                            <tr><td><strong>Date Submitted:</strong></td><td>13/09/2024</td></tr>
                            <tr><td><strong>Product:</strong></td><td>Bread</td></tr>
                            <tr><td><strong>Quantity:</strong></td><td>1</td></tr>
                            <tr><td colspan="2"><button type="button">Serve</button></td></tr>
                        </table>
                    `;

                    marker1.on('click', function() {
                        marker1.bindPopup(popupContent1).openPopup();
                    
                    });
                    // Bind a click event to the marker to open the popup with the formatted content
                    markerDon1.on('click', function() {
                        markerDon1.bindPopup(popupContentDon1).openPopup();
                    
                    });
                })();

                async function fetchUsernameById(userId) {
                    try {
                        const response = await fetch(`/getUsernameById/${userId}`);
                        if (!response.ok) {
                            throw new Error('Failed to fetch username');
                        }
                        const data = await response.json();
                        return data.username || 'Unknown';
                    } catch (error) {
                        console.error('Error fetching username:', error);
                        return 'Unknown';
                    }
                }

                async function fetchTasks() {
                    try {
                        const response = await fetch('/getTasks');  // Assuming a route '/getTasks' is set up to provide the tasks
                        const data = await response.json();

                        if (data.success) {
                            populateTasksTable(data.tasks);
                            if (data.tasks.length > 0) {
                                displayRouteForAllTasks(data.tasks); 
                            }
                        } else {
                            console.error('Failed to load tasks:', data.message);
                        }
                    } catch (error) {
                        console.error('Error fetching tasks:', error);
                    }
                }

                async function displayRouteForTask(task) {
                    try {
                        // Get the rescuer's current location
                        const rescuerLocation = markerRescuer.getLatLng();
                        const waypoints = [L.latLng(rescuerLocation.lat, rescuerLocation.lng)]; // Start from rescuer's location

                        // Get the task location (assuming task.location.coordinates are in [lat, lng])
                        if (task.location && Array.isArray(task.location.coordinates)) {
                            const [lng, lat] = task.location.coordinates; // coordinates are usually [lng, lat]
                            console.log(`Adding waypoint for task: Latitude: ${lat}, Longitude: ${lng}`);
                            waypoints.push(L.latLng(lng, lat)); // Adding the task location as a waypoint
                        } else {
                            console.warn('Invalid or missing location in task:', task);
                            return; // Exit if no valid location found
                        }

                        // Remove any existing route
                        if (window.routeControl) {
                            map.removeControl(window.routeControl);
                        }

                        // Create and display the route on the map with light blue color
                        window.routeControl = L.Routing.control({
                            waypoints: waypoints,
                            lineOptions: {
                                styles: [{ color: '#00aaff', weight: 6 }] // Customize the color and weight of the route line here
                            },
                            createMarker: function (i, waypoint, n) {
                                const markerOptions = {
                                    draggable: true
                                };
                                if (i === 0) {
                                    markerOptions.icon = RescuerIcon; // Use the rescuer icon for the first marker
                                }
                                return L.marker(waypoint.latLng, markerOptions);
                            },
                            addWaypoints: false, // Prevent users from adding waypoints manually
                            routeWhileDragging: true, // Disable recalculating the route while dragging
                            fitSelectedRoutes: false, // Automatically zoom the map to fit the route
                            show: false, // Disable the default route instructions popup
                            routeDrag: false, // Disable the ability to drag the route
                        }).addTo(map);

                    } catch (error) {
                        console.error('Error fetching tasks or calculating route:', error);
                    }
                }
                // Array to store all selected task waypoints
                let taskWaypoints = [];

                // Function to automatically calculate and display the route for all tasks
                async function displayRouteForAllTasks(tasks) {
                    try {
                        // Get the rescuer's current location
                        const rescuerLocation = markerRescuer.getLatLng();
                        const waypoints = [L.latLng(rescuerLocation.lat, rescuerLocation.lng)]; // Start from rescuer's location

                        // Loop through all tasks and add their waypoints (lat, lng) to the route
                        tasks.forEach(task => {
                            if (task.location && Array.isArray(task.location.coordinates)) {
                                const [lng, lat] = task.location.coordinates; // Correct: [lng, lat]
                                waypoints.push(L.latLng(lng, lat)); // Add task location to waypoints
                            } else {
                                console.warn('Invalid or missing location in task:', task);
                            }
                        });

                        // Remove any existing route before adding a new one
                        if (window.routeControl) {
                            map.removeControl(window.routeControl);
                        }


                        // Create and display the route on the map
                        window.routeControl = L.Routing.control({
                            waypoints: waypoints,
                            lineOptions: {
                                styles: [{ color: '#00aaff', weight: 6 }] // Customize the color and weight of the route line here
                            },
                            createMarker: function (i, waypoint, n) {
                                const markerOptions = { draggable: true };
                                if (i === 0) {
                                    markerOptions.icon = RescuerIcon; // Use the rescuer icon for the first marker
                                } else if (i > 0) {
                                    markerOptions.icon = peoplePendingIcon; // Use the task icon for the subsequent waypoints
                                }
                                return L.marker(waypoint.latLng, markerOptions);
                            },
                            addWaypoints: false, // Prevent users from adding waypoints manually
                            routeWhileDragging: true, // Disable recalculating the route while dragging
                            fitSelectedRoutes: false, // Automatically zoom the map to fit the route
                            show: false, // Disable the default route instructions popup
                            routeDrag: false, // Disable the ability to drag the route
                        }).addTo(map);
                    } catch (error) {
                        console.error('Error calculating route:', error);
                    }
                }

                function populateTasksTable(tasks) {
                    const tasksTableBody = document.querySelector('#tasksTable tbody');
                    tasksTableBody.innerHTML = '';  // Clear existing rows *** add .innerHTML

                    taskWaypoints = [];

                    tasks.forEach((task, index) => {
                        const row = document.createElement('tr');
                        row.classList.add('task-row');
                        row.dataset.taskId = task._id;


                        // Add checkbox
                        const checkboxCell = document.createElement('td');
                        const checkbox = document.createElement('input');
                        checkbox.type = 'checkbox';
                        checkbox.dataset.taskIndex = index;
                        checkboxCell.appendChild(checkbox);
                        row.appendChild(checkboxCell);

                        // Add number
                        const noCell = document.createElement('td');
                        noCell.innerText = index + 1;
                        row.appendChild(noCell);

                        // Add type
                        const typeCell = document.createElement('td');
                        typeCell.innerText = task.type.charAt(0).toUpperCase() + task.type.slice(1);
                        row.appendChild(typeCell);

                        // Add name (username)
                        const nameCell = document.createElement('td');
